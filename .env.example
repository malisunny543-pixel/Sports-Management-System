# =============================================================================
# .env.example — Example environment variable file
# =============================================================================
#
# PURPOSE:
#   This file shows WHAT environment variables are needed, with placeholder
#   values only. It is safe to commit this file to Git.
#
# HOW TO USE:
#   1. Copy this file and rename the copy to: .env
#   2. Fill in your actual values in the .env file
#   3. NEVER commit your .env file to Git (it is already in .gitignore)
#
# =============================================================================

# --- Flask Settings ---
# A random secret key used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here

# Set to 'production' on Render to disable debug mode and enforce secure cookies.
# Leave as 'development' for local work.
FLASK_ENV=development

# Force session cookies to require HTTPS. Automatically true when FLASK_ENV=production.
# SESSION_COOKIE_SECURE=false

# --- Database Settings ---
# The hostname where MySQL is running. Usually 'localhost' for local development.
DB_HOST=localhost

# The port MySQL listens on. Default MySQL port is 3306.
DB_PORT=3306

# Your MySQL username. Default install creates a 'root' user.
DB_USER=root

# Your MySQL password. Fill in your actual password in the .env file.
DB_PASSWORD=your-mysql-password-here

# The name of the database for this project.
DB_NAME=sports_management

# --- SSL/TLS (Aiven or other managed MySQL) ---
# Path to the CA certificate file for SSL database connections.
# Leave commented out for local MySQL without SSL.
# DB_SSL_CA=/path/to/database/ca.pem
